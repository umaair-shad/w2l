{
  "name": "w2l-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@w2l/web",
    "dev:server": "npm run dev --workspace=@w2l/server",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "test:agent": "npm run test:agent --workspace=@w2l/server",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
